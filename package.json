{
	"name": "oxlint-plugin-utilities",
	"version": "1.1.0",
	"description": "A smarter wrapper around Oxlint's JS plugins types.",
	"keywords": [
		"lint",
		"linting",
		"oxlint",
		"plugin",
		"rules",
		"utilities"
	],
	"license": "CC0-1.0",
	"author": {
		"name": "HowManySmall"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/oxlint-plugin-utilities.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"attw": "attw",
		"biome": "biome",
		"build": "jiti ./scripts/build.ts",
		"changelogithub": "changelogithub",
		"commitlint": "commitlint",
		"format": "oxfmt --no-error-on-unmatched-pattern",
		"knip": "knip-bun",
		"lint": "bash -c 'a=$(bash scripts/default-src.sh \"$@\"); nr oxc $a && nr biome check --no-errors-on-unmatched $a' _",
		"oxc": "oxlint --no-error-on-unmatched-pattern",
		"oxfmt": "oxfmt",
		"oxlint": "oxlint",
		"prepare": "lefthook install",
		"prepublishOnly": "nr build -- --package-checks",
		"publint": "publint",
		"release": "bumpp",
		"test": "nr build && vitest run",
		"type-check": "tsgo --noEmit"
	},
	"dependencies": {
		"@oxlint/plugins": "1.71.0",
		"type-fest": "5.7.0"
	},
	"devDependencies": {
		"@antfu/ni": "30.2.0",
		"@arethetypeswrong/cli": "0.18.4",
		"@biomejs/biome": "2.5.1",
		"@cliffy/command": "jsr:1.2.1",
		"@commitlint/config-conventional": "21.1.0",
		"@commitlint/types": "21.1.0",
		"@pobammer-ts/small-rules": "2.1.0",
		"@std/path": "jsr:1.1.5",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "25.9.3",
		"@typescript/native-preview": "7.0.0-dev.20260629.1",
		"@vitest/coverage-v8": "4.1.9",
		"arktype": "2.2.1",
		"bumpp": "11.1.0",
		"changelogithub": "14.0.0",
		"commitlint": "21.1.0",
		"consola": "3.4.2",
		"jiti": "2.7.0",
		"knip": "6.23.0",
		"oxfmt": "0.56.0",
		"oxlint": "1.71.0",
		"oxlint-tsgolint": "0.23.0",
		"picocolors": "1.1.1",
		"pretty-bytes": "7.1.0",
		"pretty-ms": "9.3.0",
		"publint": "0.3.21",
		"temporal-polyfill": "1.0.1",
		"tsdown": "0.22.3",
		"vitest": "4.1.9",
		"zx": "8.8.5"
	},
	"peerDependencies": {
		"typescript": ">=5 <8"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "aube@1.25.1"
}
