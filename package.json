{
	"name": "oxlint-plugin-utilities",
	"version": "1.0.0",
	"description": "A smarter wrapper around Oxlint's JS plugins types.",
	"keywords": [
		"lint",
		"linting",
		"oxlint",
		"plugin",
		"rules",
		"utilities"
	],
	"license": "CC0-1.0",
	"author": {
		"name": "HowManySmall"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/oxlint-plugin-utilities.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"attw": "attw",
		"biome": "biome",
		"build": "jiti ./scripts/build.ts",
		"changelogithub": "changelogithub",
		"commitlint": "commitlint",
		"format": "oxfmt --no-error-on-unmatched-pattern",
		"knip": "knip-bun",
		"lint": "bash -c 'a=$(bash scripts/default-src.sh \"$@\"); aube run oxc $a && aube run biome check --no-errors-on-unmatched $a' _",
		"oxc": "oxlint --no-error-on-unmatched-pattern",
		"prepare": "lefthook install",
		"prepublishOnly": "aube run build -- --package-checks",
		"publint": "publint",
		"release": "bumpp",
		"test": "aube run build && vitest run",
		"type-check": "tsgo --noEmit"
	},
	"dependencies": {
		"@oxlint/plugins": "^1.70.0",
		"type-fest": "^5.7.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.3",
		"@biomejs/biome": "^2.5.0",
		"@cliffy/command": "jsr:^1.1.0",
		"@commitlint/config-conventional": "^21.0.2",
		"@commitlint/types": "^21.0.1",
		"@pobammer-ts/small-rules": "^2.0.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^25.9.3",
		"@typescript/native-preview": "^7.0.0-dev.20260620.1",
		"@vitest/coverage-v8": "4.1.9",
		"arktype": "^2.2.1",
		"bumpp": "^11.1.0",
		"changelogithub": "^14.0.0",
		"commitlint": "^21.0.2",
		"consola": "^3.4.2",
		"jiti": "^2.7.0",
		"knip": "^6.17.1",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0",
		"oxlint-tsgolint": "^0.23.0",
		"pretty-bytes": "^7.1.0",
		"pretty-ms": "^9.3.0",
		"publint": "^0.3.21",
		"temporal-polyfill": "^0.3.2",
		"tsdown": "^0.22.3",
		"typescript": "^5",
		"vitest": "4.1.9",
		"yoctocolors": "^2.1.2",
		"zx": "^8.8.5"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "aube@1.22.0"
}
