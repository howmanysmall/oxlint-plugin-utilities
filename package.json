{
	"name": "oxlint-plugin-utilities",
	"version": "1.0.0",
	"description": "A smarter wrapper around Oxlint's JS plugins types.",
	"keywords": [
		"lint",
		"linting",
		"oxlint",
		"plugin",
		"rules",
		"utilities"
	],
	"license": "MIT",
	"author": {
		"name": "HowManySmall"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/oxlint-plugin-utilities.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "src/index.ts",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"biome:check": "biome check",
		"biome:ci": "biome ci",
		"biome:lint": "biome lint",
		"build": "bun run ./scripts/build.ts",
		"build:oxc": "bun run ./scripts/build-small-rules.ts",
		"commitlint": "commitlint --edit",
		"format": "oxfmt",
		"knip": "knip-bun",
		"lint": "bash -c 'a=$(bash scripts/default-src.sh \"$@\"); bun run oxc $a && bun run biome:check $a' _",
		"oxc": "oxlint",
		"prepare": "lefthook install",
		"prepublishOnly": "bun run build",
		"release": "bumpp",
		"test": "bun run build && vitest run",
		"type-check": "tsgo --noEmit"
	},
	"dependencies": {
		"@oxlint/plugins": "^1.60.0",
		"type-fest": "^5.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@commitlint/config-conventional": "^20.5.0",
		"@commitlint/types": "^20.5.0",
		"@jsr/cliffy__command": "^1.0.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/bun": "1.3.12",
		"@types/node": "^25.5.2",
		"@typescript/native-preview": "^7.0.0-dev.20260418.1",
		"@vitest/coverage-v8": "^4.1.4",
		"arktype": "^2.2.0",
		"bumpp": "^11.0.1",
		"changelogithub": "^14.0.0",
		"commitlint": "^20.5.0",
		"consola": "^3.4.2",
		"knip": "^6.4.1",
		"oxc-parser": "^0.126.0",
		"oxfmt": "^0.45.0",
		"oxlint": "^1.60.0",
		"oxlint-tsgolint": "^0.21.1",
		"picocolors": "^1.1.1",
		"pretty-bytes": "^7.1.0",
		"pretty-ms": "^9.3.0",
		"temporal-polyfill": "^0.3.2",
		"vitest": "^4.1.4"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.12"
}
