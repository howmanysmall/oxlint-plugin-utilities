{
	"compilerOptions": {
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"paths": {
			"#src": ["./src/index.ts"],
			"#src/*": ["./src/*"],
		},
		"rootDir": ".",
		"types": ["node", "vitest/globals"],
	},
	"exclude": ["dist", "node_modules"],
	"extends": "./tsconfig.base.json",
	"include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.test-d.ts", "vitest.config.ts"],
}
